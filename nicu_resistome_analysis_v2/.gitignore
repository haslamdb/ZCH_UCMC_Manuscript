# Pipeline runtime outputs (large; not for version control)
radar_runs/
logs/

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Large binary / sequencing artifacts (precaution)
*.fastq
*.fastq.gz
*.bam
*.sam
*.h5
*.hdf5
*.dmnd

# Editor / OS
.DS_Store
*.swp
*~

# Pipeline operations: pre-fix snapshots (kept locally for safety, not tracked)
*.pre_canonicalize
*.pre_zero_augment

# Track v2 figures and result tables (parent repo .gitignore excludes *.pdf
# and *.tsv globally; we re-include them here so remote checkouts have the
# rendered analysis outputs without re-running the pipeline).
!figures/**/*.pdf
!results/**/*.tsv
!results/**/*.txt
!results/**/*.md
